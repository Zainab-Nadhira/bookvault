# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/bookvault?retryWrites=true&w=majority
MONGO_URI=your_mongodb_atlas_uri_here

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS - your deployed frontend URL (Vercel) plus local dev
CLIENT_URL=http://localhost:5173
